{
  "name": "how-europe-works",
  "private": true,
  "version": "0.1.0",
  "description": "HOW EUROPE WORKS - exploratory interface about the world of work in European cities (p5.js + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "data": "tsx scripts/build-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint . && prettier --check . && vitest run"
  },
  "dependencies": {
    "p5": "^1.11.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/p5": "^1.7.7",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
